# AI Developer Assistant CLI Configuration Example
# Copy this file to '.env' and fill in your details

# The API key for Gemini API (e.g. from Google AI Studio)
GEMINI_API_KEY=your_api_key_here

# Optional: Base URL for custom/gateway Gemini endpoint
# GEMINI_API_BASE=https://generativelanguage.googleapis.com

# The Gemini model to use (defaults to gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: The model temperature (defaults to 0.7)
# GEMINI_TEMPERATURE=0.7
